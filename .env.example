# ---- PostgreSQL ----
POSTGRES_DB=rh_database
POSTGRES_USER=rh_user
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE

# ---- JWT (openssl rand -base64 64) ----
JWT_SECRET=YOUR_64_CHAR_BASE64_JWT_SECRET_HERE
JWT_EXPIRATION_HOURS=12

# ---- Domains (CORS + reset-password link uses the FIRST url) ----
FRONTEND_URL=https://project.antigoneinterne.agency,https://rh.antigoneinterne.agency
# Used at frontend BUILD time for the Projets/RH switch button
PROJECTS_APP_URL=https://project.antigoneinterne.agency
RH_APP_URL=https://rh.antigoneinterne.agency
FRONTEND_PORT=8081

# ---- Mail (Brevo) : MAIL_USERNAME must be a verified sender on antigoneinterne.agency ----
MAIL_USERNAME=noreply@antigoneinterne.agency
BREVO_API_KEY=xkeysib-...

# ---- Google Drive ----
# Files go in ./secrets/service-account.json and ./secrets/client-viewer-service-account.json
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY_PATH=/app/service-account.json
GOOGLE_DRIVE_CLIENT_VIEWER_KEY_PATH=/app/client-viewer-service-account.json
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-folder-id
# Must be listed in Google Cloud Console > OAuth client > Authorized redirect URIs
GOOGLE_DRIVE_REDIRECT_URI=https://project.antigoneinterne.agency/api/media-plans/google-drive/callback
