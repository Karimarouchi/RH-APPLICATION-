@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam class {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
hide circle
hide empty members

title Diagramme de classes — Présence et monitoring

class Employe {
  - id : Long
  - nom : String
  - prenom : String
  - salaire : Double
}

class Pointage {
  - id : Long
  - datePointage : Date
  - heureEntree : Time
  - heureSortie : Time
  - ipEntree : String
  - ssidEntree : String
  - retardMinutes : Integer
  - statut : String
  - surReseauEntreprise : Boolean
  - teletravail : Boolean
}

class Heartbeat <<signal d'activité>> {
  - id : Long
  - timestamp : DateTime
  - ipAddress : String
  - ssid : String
  - actif : Boolean
  - surReseauEntreprise : Boolean
}

class PresenceConfirmation {
  - id : Long
  - timestamp : DateTime
  - confirmed : Boolean
}

class RapportInactivite {
  - id : Long
  - semaineDebut : Date
  - semaineFin : Date
  - totalInactiviteMinutes : Integer
  - toleranceMinutes : Integer
  - inactiviteExcedentaire : Integer
  - retardCumule : Integer
  - montantDeduction : Double
  - decision : String
  - commentaire : String
  - dateDecision : DateTime
  - dateGeneration : DateTime
  --
  + decider(decision : String, commentaire : String) : void
}

Pointage "0..*" --> "1" Employe
Heartbeat "0..*" --> "1" Employe
PresenceConfirmation "0..*" --> "1" Employe
RapportInactivite "0..*" --> "1" Employe : concerne
RapportInactivite "0..*" --> "0..1" Employe : décidé par

note bottom of Pointage
  statut : PRESENT, RETARD, TELETRAVAIL,
  EN_CONGE, JOUR_FERIE, JOUR_NON_TRAVAILLE
end note

note bottom of RapportInactivite
  decision : EN_ATTENTE, DEDUIT, ANNULE
end note

note bottom of Heartbeat
  Envoyé chaque minute par
  l'agent installé sur le poste.
end note

@enduml
