@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam class {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
hide circle
hide empty members

title Diagramme de classes — Calendrier et paramétrage

class Employe {
  - id : Long
  - nom : String
  - prenom : String
}

class HoraireTravail {
  - id : Long
  - nom : String
  - heureDebut : Time
  - heureFin : Time
  - pauseDebutMidi : Time
  - pauseFinMidi : Time
  - joursTravail : String
  - joursTeletravail : String
  - dateDebut : Date
  - dateFin : Date
}

class AffectationHoraire {
  - id : Long
  - dateDebut : Date
  - dateFin : Date
}

class Calendrier {
  - id : Long
  - dateJour : Date
  - nomJour : String
  - typeJour : TypeJour
  - origine : OrigineJour
  - description : String
  - estPaye : Boolean
}

class Referentiel {
  - id : Long
  - libelle : String
  - description : String
  - actif : Boolean
  - valeur : String
  - typeReferentiel : TypeReferentiel
  --
  + activerDesactiver() : void
}

class TacheObligatoire <<restriction de congé>> {
  - id : Long
  - nom : String
  - dates : String
}

enum TypeJour {
  OUVRABLE
  FERIE
  CONGE_PAYE
  CONGE_NON_PAYE
  TELETRAVAIL
}

enum OrigineJour {
  NATIONAL
  INTERNATIONAL
}

enum TypeReferentiel {
  DEPARTEMENT
  TYPE_CONTRAT
  SITE_ETABLISSEMENT
  POSTE
  NIVEAU_HIERARCHIQUE
  TYPE_CONGE
  TYPE_DEMANDE
  GENRE
  PARAMETRE_SYSTEME
}

AffectationHoraire "0..*" --> "1" Employe
AffectationHoraire "0..*" --> "1" HoraireTravail
TacheObligatoire "0..*" --> "0..1" Employe : concerne

Calendrier ..> TypeJour
Calendrier ..> OrigineJour
Referentiel ..> TypeReferentiel

note bottom of Calendrier
  Jours fériés et jours spéciaux de
  l'entreprise. Utilisés pour calculer
  les jours de congé effectifs.
end note

note bottom of Referentiel
  PARAMETRE_SYSTEME contient par ex. :
  SOLDE_CONGE_AN1 = 18, SOLDE_CONGE_AN2_PLUS = 24,
  MAX_REPORT_CONGE = 5, MAX_AUTORISATION_MINUTES = 120.
end note

note bottom of TacheObligatoire
  Jours où l'employé doit être présent :
  il ne peut pas y poser de congé.
end note

@enduml
