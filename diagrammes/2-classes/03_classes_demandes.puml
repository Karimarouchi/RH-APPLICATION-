@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam class {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
hide circle
hide empty members

title Diagramme de classes — Demandes et validation

class Employe {
  - id : Long
  - nom : String
  - prenom : String
  - departement : String
  - soldeConge : Double
}

class Demande {
  - id : Long
  - type : TypeDemande
  - dateCreation : DateTime
  - statut : StatutDemande
  - raison : String
  - motifRefus : String
  - raisonAnnulation : String
  --
  + soumettre() : void
  + modifier() : void
  + approuver() : void
  + refuser(motif : String) : void
  + annuler() : void
}

class Conge {
  - typeConge : TypeConge
  - dateDebut : Date
  - dateFin : Date
  - nombreJours : Integer
  - joursOuvrables : Integer
  - justificatifPath : String
  --
  + calculerJoursEffectifs() : Integer
}

class Autorisation {
  - date : Date
  - heureDebut : Time
  - heureFin : Time
}

class Teletravail {
  - dateDebut : Date
  - dateFin : Date
}

class Validation {
  - id : Long
  - ordre : Integer
  - decision : DecisionValidation
  - dateValidation : DateTime
  - commentaire : String
}

class HistoriqueStatut {
  - id : Long
  - ancienStatut : StatutDemande
  - nouveauStatut : StatutDemande
  - dateChangement : DateTime
  - commentaire : String
}

enum TypeDemande {
  CONGE
  AUTORISATION
  TELETRAVAIL
  ADMINISTRATION
}

enum StatutDemande {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
  ANNULEE
  BROUILLON
  VALIDEE
}

enum DecisionValidation {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
}

enum TypeConge {
  CONGE_PAYE
  CONGE_MALADIE
  CONGE_MATERNITE
  CONGE_PATERNITE
  CONGE_SANS_SOLDE
  CONGE_EXCEPTIONNEL
  CONGE_FORMATION
  CONGE_RECUPERATION
  CONGE_ADMINISTRATIF
  CONGE_REGLES
  CONGE_DECES_PROCHE
  CONGE_DECES_FAMILLE
}

Employe "1" -- "0..*" Demande : soumet
Demande <|-- Conge
Demande <|-- Autorisation
Demande <|-- Teletravail
Demande "1" *-- "0..*" Validation
Validation "0..*" --> "1" Employe : validateur
Demande "1" *-- "0..*" HistoriqueStatut
HistoriqueStatut "0..*" --> "0..1" Employe : modifié par

Conge -[hidden]down- StatutDemande
Teletravail -[hidden]down- TypeDemande
Autorisation -[hidden]down- DecisionValidation
StatutDemande -[hidden]right- TypeDemande
TypeDemande -[hidden]right- DecisionValidation
DecisionValidation -[hidden]right- TypeConge

note bottom of Demande
  Une <b>demande de document</b> (« demande papier »)
  est une Demande de type ADMINISTRATION :
  BROUILLON → VALIDEE ou ANNULEE.
end note

note bottom of Validation
  Créée automatiquement pour le
  chef du département de l'employé.
end note

@enduml
