@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam state {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}

title Diagramme d'états — Demande de document administratif

state "En attente\n(Brouillon)" as BROUILLON
state "Validée" as VALIDEE
state "Annulée" as ANNULEE

[*] --> BROUILLON : demander (employé)
BROUILLON --> VALIDEE : accepter (RH)\n/ notifier l'employé
BROUILLON --> ANNULEE : refuser + motif (RH)\n/ notifier l'employé

VALIDEE --> [*]
ANNULEE --> [*]

@enduml
