@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam state {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}

title Diagramme d'états — Demande de congé, d'autorisation ou de télétravail

state "En attente" as EN_ATTENTE
state "Approuvée" as APPROUVEE
state "Refusée" as REFUSEE
state "Annulée" as ANNULEE

[*] --> EN_ATTENTE : soumettre\n[règles respectées]
EN_ATTENTE --> EN_ATTENTE : modifier (employé)
EN_ATTENTE --> APPROUVEE : approuver\n(RH ou chef de département)
EN_ATTENTE --> REFUSEE : refuser + motif\n(RH ou chef de département)
EN_ATTENTE --> ANNULEE : annuler (employé)

APPROUVEE --> [*]
REFUSEE --> [*]
ANNULEE --> [*]

note right of APPROUVEE
  Congé payé : les jours sont
  déduits du solde à ce moment.
end note

note right of EN_ATTENTE
  Les jours d'un congé payé en attente
  réduisent le solde prévisionnel,
  pas le solde disponible.
end note

@enduml
