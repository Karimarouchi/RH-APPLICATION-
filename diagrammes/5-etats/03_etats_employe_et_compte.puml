@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam state {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}

title Diagramme d'états — Employé et compte utilisateur

state "Employé" as EMP {
  state "Actif" as E_ACTIF
  state "Archivé" as E_ARCHIVE

  [*] --> E_ACTIF : créer la fiche (RH)
  E_ACTIF --> E_ARCHIVE : archiver (RH)
  E_ARCHIVE --> E_ACTIF : désarchiver (RH)
  E_ARCHIVE --> [*] : supprimer définitivement\n(Administrateur)
}

state "Compte utilisateur" as CPT {
  state "Mot de passe provisoire" as C_PROV
  state "Actif" as C_ACTIF
  state "Désactivé" as C_OFF

  [*] --> C_PROV : créer le compte\n(Administrateur)
  C_PROV --> C_ACTIF : changer le mot de passe\n(1ère connexion)
  C_ACTIF --> C_OFF : désactiver
  C_OFF --> C_ACTIF : réactiver
  C_ACTIF --> [*] : supprimer le compte
  C_OFF --> [*] : supprimer le compte
}

note bottom of CPT
  Un compte désactivé ne peut plus se connecter.
  Supprimer un compte ne supprime pas l'employé.
end note

@enduml
