@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam state {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}

title Diagramme d'états — Rapport d'inactivité

state "En attente" as EN_ATTENTE
state "Déduit" as DEDUIT
state "Annulé" as ANNULE

[*] --> EN_ATTENTE : générer (RH)
EN_ATTENTE --> DEDUIT : décider « déduire »\n+ commentaire
EN_ATTENTE --> ANNULE : décider « annuler »\n+ commentaire

DEDUIT --> [*]
ANNULE --> [*]

@enduml
