@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #683B77
skinparam usecase {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam rectangle {
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
left to right direction

title Cas d'utilisation — Suivi de la présence (Monitoring)

actor "Responsable RH" as RH
actor "Agent Desktop\n<<système>>" as AGENT
actor "Planificateur\n<<système>>" as CRON

rectangle "Monitoring" {
  usecase "Suivre la présence\nen temps réel" as UC1
  usecase "Générer les rapports\nd'inactivité" as UC2
  usecase "Décider sur un rapport\n(déduire / annuler)" as UC3
  usecase "Consulter l'historique\nde présence d'un employé" as UC4

  usecase "Envoyer les signaux\nd'activité" as UC5
  usecase "Clôturer automatiquement\nun pointage oublié" as UC6
}

RH --> UC1
RH --> UC2
RH --> UC3
RH --> UC4

UC5 <-- AGENT
UC6 <-- CRON

note as N_UC1
  <b>Suivre la présence en temps réel</b>
  Statut de chaque employé (présent,
  en retard, télétravail, en congé, absent)
  et temps actif / inactif de la journée.
end note

note as N_UC2
  <b>Générer les rapports d'inactivité</b>
  Par semaine ou par période :
  inactivité au-delà de la tolérance,
  retards cumulés, montant de déduction.
end note

note as N_UC5
  <b>Envoyer les signaux d'activité</b>
  Toutes les minutes, l'agent indique
  si le poste est actif et s'il est
  connecté au réseau de l'entreprise.
end note

note as N_UC6
  <b>Clôturer automatiquement un pointage oublié</b>
  Sans signal depuis 10 minutes,
  l'heure de sortie est remplie
  avec le dernier signal reçu.
end note

note as N1
  <b>Toutes les actions nécessitent</b>
  <b>une authentification préalable.</b>
end note

@enduml
