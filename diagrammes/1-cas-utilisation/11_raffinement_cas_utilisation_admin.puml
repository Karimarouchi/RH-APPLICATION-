@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #683B77
skinparam usecase {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam rectangle {
  BorderColor #683B77
}
skinparam package {
  BorderColor #683B77
  FontColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
left to right direction

title Raffinement du cas d'utilisation — Rôle Administrateur

actor "Administrateur" as ADM
actor "Responsable RH" as RH
actor "Messagerie" as MAIL

ADM -up-|> RH

rectangle "Administration de l'application" {

  package "Gestion des comptes" {
    usecase "Créer un compte\npour un employé" as UC1
    usecase "Envoyer les identifiants\npar e-mail" as UC1a
    usecase "Modifier un compte" as UC2
    usecase "Attribuer un ou plusieurs rôles" as UC2a
    usecase "Activer / désactiver\nun compte" as UC3
    usecase "Ajouter ou retirer un droit\npour une seule personne" as UC4
    usecase "Consulter l'historique\ndes connexions" as UC5
    usecase "Supprimer définitivement\nun compte" as UC6
  }

  package "Gestion des rôles" {
    usecase "Consulter les rôles" as UC7
    usecase "Créer un rôle" as UC8
    usecase "Modifier un rôle" as UC9
    usecase "Choisir les pages et actions\nautorisées" as UC10
    usecase "Donner l'accès total" as UC10a
    usecase "Supprimer un rôle" as UC11
  }

  package "Actions réservées" {
    usecase "Supprimer définitivement\nun employé archivé" as UC12
    usecase "Approuver ses propres\ndemandes" as UC13
  }
}

ADM --> UC1
ADM --> UC2
ADM --> UC3
ADM --> UC4
ADM --> UC5
ADM --> UC6

ADM --> UC7
ADM --> UC8
ADM --> UC9
ADM --> UC11

ADM --> UC12
ADM --> UC13

UC1 ..> UC1a : <<include>>
UC1a --> MAIL
UC2a .> UC2 : <<extend>>

UC8 ..> UC10 : <<include>>
UC9 ..> UC10 : <<include>>
UC10a .> UC10 : <<extend>>

note as N_UC1
  <b>Créer un compte pour un employé</b>
  Un mot de passe provisoire est créé
  et envoyé à l'employé, qui doit le
  changer à sa première connexion.
end note

note as N_UC4
  <b>Ajouter ou retirer un droit pour une seule personne</b>
  Exception pour un seul compte,
  sans changer son rôle.
end note

note as N_UC11
  <b>Supprimer un rôle</b>
  Impossible tant que le rôle est
  encore attribué à des comptes.
end note

note as N_UC3
  <b>Activer / désactiver un compte</b>
  Un compte désactivé ne peut plus
  se connecter à l'application.
end note

note as N1
  <b>Toutes les actions demandent</b>
  <b>d'être connecté à son compte.</b>
  L'Administrateur a un <b>accès total</b> :
  il peut aussi faire tout ce que fait
  le Responsable RH (et donc l'Employé).
end note

@enduml
