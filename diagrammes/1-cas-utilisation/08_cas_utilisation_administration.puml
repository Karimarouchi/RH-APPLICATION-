@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #683B77
skinparam usecase {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam rectangle {
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
left to right direction

title Cas d'utilisation — Administration des accès

actor "Administrateur" as ADM
actor "Service e-mail\n<<système>>" as MAIL

rectangle "Administration" {
  usecase "Créer un compte\npour un employé" as UC1
  usecase "Modifier un compte\n(identifiant, rôles)" as UC2
  usecase "Activer / désactiver\nun compte" as UC3
  usecase "Ajouter / retirer des droits\nindividuels" as UC4
  usecase "Consulter le journal\nd'accès" as UC5
  usecase "Supprimer un compte" as UC6

  usecase "Créer / modifier un rôle" as UC7
  usecase "Choisir les permissions\ndu rôle" as UC8
  usecase "Supprimer un rôle" as UC9
}

ADM --> UC1
ADM --> UC2
ADM --> UC3
ADM --> UC4
ADM --> UC5
ADM --> UC6
ADM --> UC7
ADM --> UC9

UC7 ..> UC8 : <<include>>
UC1 --> MAIL

note as N_UC1
  <b>Créer un compte pour un employé</b>
  Un mot de passe provisoire est
  généré et envoyé par e-mail.
end note

note as N_UC4
  <b>Ajouter / retirer des droits individuels</b>
  Exception pour un seul compte,
  sans modifier son rôle.
end note

note as N_UC9
  <b>Supprimer un rôle</b>
  Impossible si le rôle est encore
  attribué à des comptes.
end note

note as N1
  <b>Toutes les actions nécessitent</b>
  <b>une authentification préalable.</b>
end note

@enduml
