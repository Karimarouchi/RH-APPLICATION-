@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #683B77
skinparam usecase {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam rectangle {
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
left to right direction

title Cas d'utilisation — Traitement des demandes

actor "Chef de\ndépartement" as CHEF
actor "Responsable RH" as RH

rectangle "Validation des demandes" {
  usecase "Consulter les demandes\nde son département" as UC1
  usecase "Consulter toutes\nles demandes" as UC2
  usecase "Approuver une demande" as UC3
  usecase "Refuser une demande" as UC4
  usecase "Saisir le motif du refus" as UC5
  usecase "Traiter plusieurs demandes\nen une fois" as UC6
  usecase "Consulter l'historique\net le justificatif" as UC7
  usecase "Traiter une demande\nde document" as UC8
}

CHEF --> UC1
CHEF --> UC3
CHEF --> UC4

RH --> UC2
RH --> UC3
RH --> UC4
RH --> UC6
RH --> UC7
RH --> UC8

UC4 ..> UC5 : <<include>>

note as N_UC1
  <b>Consulter les demandes de son département</b>
  Le chef de département est notifié
  dès qu'un membre de son département
  envoie une demande.
end note

note as N_UC3
  <b>Approuver une demande</b>
  - Seules les demandes « en attente »
    peuvent être traitées.
  - Personne ne peut approuver sa propre
    demande (sauf l'Administrateur).
  - Un congé payé approuvé est déduit
    du solde de l'employé.
  - L'employé est notifié de la décision.
end note

note as N1
  <b>Toutes les actions nécessitent</b>
  <b>une authentification préalable.</b>
end note

@enduml
