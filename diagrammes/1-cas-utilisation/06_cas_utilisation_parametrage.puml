@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #683B77
skinparam usecase {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam rectangle {
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
left to right direction

title Cas d'utilisation — Paramétrage RH

actor "Responsable RH" as RH

rectangle "Paramétrage" {
  usecase "Gérer les jours fériés\net jours spéciaux" as UC1
  usecase "Gérer les horaires\nde travail" as UC2
  usecase "Gérer les référentiels" as UC3
  usecase "Modifier les paramètres\nsystème" as UC4
  usecase "Activer / désactiver\nun élément" as UC5
  usecase "Gérer les restrictions\nde congés" as UC6
}

RH --> UC1
RH --> UC2
RH --> UC3
RH --> UC6

UC4 .> UC3 : <<extend>>
UC5 .> UC3 : <<extend>>

note as N_UC1
  <b>Gérer les jours fériés et jours spéciaux</b>
  Création d'un jour ou d'une
  période entière (par lot).
end note

note as N_UC2
  <b>Gérer les horaires de travail</b>
  Heures d'entrée/sortie, pause,
  jours travaillés, jours de télétravail
  et période de validité.
end note

note as N_UC3
  <b>Gérer les référentiels</b>
  Départements, postes, types de contrat,
  types de congé, types de document…
end note

note as N_UC4
  <b>Modifier les paramètres système</b>
  Droit annuel (18 j / 24 j), taux mensuel,
  report maximum (5 j), quota mensuel
  d'autorisation (120 min)…
end note

note as N_UC6
  <b>Gérer les restrictions de congés</b>
  Jours où certains collaborateurs
  ne peuvent pas prendre de congé.
end note

note as N1
  <b>Toutes les actions nécessitent</b>
  <b>une authentification préalable.</b>
end note

@enduml
