@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam ArrowColor #683B77
skinparam usecase {
  BackgroundColor #F7F1FA
  BorderColor #683B77
}
skinparam rectangle {
  BorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
left to right direction

title Cas d'utilisation — Gestion du personnel

actor "Responsable RH" as RH
actor "Administrateur" as ADM
actor "Planificateur\n<<système>>" as CRON

ADM -up-|> RH

rectangle "Gestion du personnel" {
  usecase "Ajouter / modifier\nun employé" as UC1
  usecase "Rechercher et consulter\nune fiche employé" as UC2
  usecase "Gérer les documents\nde l'employé" as UC3
  usecase "Ajuster le solde\nde congé" as UC4
  usecase "Archiver / désarchiver\nun employé" as UC5
  usecase "Exporter la liste\ndes employés" as UC6
  usecase "Consulter l'organigramme" as UC7
  usecase "Gérer les départements\n(désigner le chef)" as UC8
  usecase "Consulter le tableau\nde bord RH" as UC9
  usecase "Supprimer définitivement\nun employé archivé" as UC10
  usecase "Alerter sur les fins\nde contrat" as UC11
}

RH --> UC1
RH --> UC2
RH --> UC3
RH --> UC4
RH --> UC5
RH --> UC6
RH --> UC7
RH --> UC8
RH --> UC9

ADM --> UC10

UC11 <-- CRON

note as N_UC3
  <b>Gérer les documents de l'employé</b>
  Contrat, attestation, certificat,
  diplôme… avec date d'expiration.
end note

note as N_UC10
  <b>Supprimer définitivement un employé archivé</b>
  Nécessite la permission
  « Supprimer des employés ».
end note

note as N_UC11
  <b>Alerter sur les fins de contrat</b>
  Chaque jour à 8h : contrats CDD
  (1 mois avant) et CIVP (30, 7 et
  3 jours avant). Le Responsable RH
  reçoit une notification.
end note

note as N1
  <b>Toutes les actions nécessitent</b>
  <b>une authentification préalable.</b>
end note

@enduml
