@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam sequence {
  LifeLineBorderColor #9C7BAA
  ParticipantBorderColor #683B77
  ParticipantBackgroundColor #F7F1FA
  ActorBorderColor #683B77
  ActorBackgroundColor #F7F1FA
  GroupBorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
autonumber
hide footbox

title Diagramme de séquence — Réinitialiser un mot de passe oublié

actor "Utilisateur" as U
boundary "Interface" as UI
control "Serveur" as S
database "Base de données" as DB
participant "Service e-mail" as MAIL

== Demande de réinitialisation ==
U -> UI : Cliquer « Mot de passe oublié »\net saisir son e-mail
UI -> S : Demande de réinitialisation (e-mail)
S -> DB : Rechercher le compte lié à l'e-mail
DB --> S : Compte

opt Compte trouvé et actif
  S -> S : Générer un lien unique\nvalable 30 minutes
  S -> DB : Enregistrer le jeton et son expiration
  S -> MAIL : Envoyer le lien de réinitialisation
  MAIL --> U : E-mail avec le lien
end
S --> UI : Message de confirmation
UI --> U : « Si l'adresse existe, un e-mail a été envoyé »

note right of S
  Le message est le même dans tous les cas,
  pour ne pas révéler si l'e-mail existe.
end note

== Choix du nouveau mot de passe ==
U -> UI : Ouvrir le lien et saisir\nle nouveau mot de passe
UI -> S : Réinitialiser (jeton, nouveau mot de passe)
S -> DB : Rechercher le compte par jeton
DB --> S : Compte

alt Lien expiré ou invalide
  S --> UI : Erreur « Le lien a expiré »
  UI --> U : Afficher l'erreur
else Lien valide
  S -> DB : Enregistrer le nouveau mot de passe (chiffré)\net supprimer le jeton
  S --> UI : Succès
  UI --> U : Rediriger vers la page de connexion
end

@enduml
