@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam sequence {
  LifeLineBorderColor #9C7BAA
  ParticipantBorderColor #683B77
  ParticipantBackgroundColor #F7F1FA
  ActorBorderColor #683B77
  ActorBackgroundColor #F7F1FA
  GroupBorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
autonumber
hide footbox

title Diagramme de séquence — Pointage automatique par l'agent desktop

actor "Employé" as E
participant "Agent Desktop\n(sur le poste)" as AG
control "Serveur" as S
database "Base de données" as DB
participant "Planificateur" as CRON

note over E, DB : Pré-condition : l'agent est installé et l'employé s'y est connecté.

== Arrivée ==
E -> AG : Allumer son poste
AG -> S : Premier signal de la journée → « Arrivée »\n(adresse IP, réseau Wi-Fi)
S -> DB : Lire le calendrier, l'horaire,\nles congés et télétravails
S -> S : Déterminer le statut du jour
S -> DB : Enregistrer le pointage\n(heure d'entrée, statut, retard)

== Pendant la journée ==
loop Toutes les minutes
  AG -> S : Signal d'activité\n(actif / inactif, réseau entreprise)
  S -> DB : Enregistrer le signal
end

opt Demande de confirmation de présence
  AG -> E : Fenêtre « Êtes-vous présent ? »
  E -> AG : Répondre
  AG -> S : Réponse (confirmée ou non)
  S -> DB : Enregistrer la réponse
end

== Départ ==
alt Fin des horaires ou fermeture de l'agent
  AG -> S : « Départ »
  S -> DB : Enregistrer l'heure de sortie
else Poste éteint sans départ
  CRON -> DB : Toutes les 5 min : chercher les pointages\nsans sortie et sans signal depuis 10 min
  CRON -> DB : Heure de sortie = dernier signal reçu
end

note right of S
  Statut : jour férié, jour non travaillé,
  en congé, télétravail, retard ou présent.
  Le retard tient compte d'une autorisation
  de sortie approuvée ce jour-là.
end note

@enduml
