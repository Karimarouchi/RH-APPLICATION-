@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam sequence {
  LifeLineBorderColor #9C7BAA
  ParticipantBorderColor #683B77
  ParticipantBackgroundColor #F7F1FA
  ActorBorderColor #683B77
  ActorBackgroundColor #F7F1FA
  GroupBorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}
autonumber
hide footbox

title Diagramme de séquence — Modifier ou annuler une demande en attente

actor "Employé" as E
boundary "Page « Mes demandes »" as UI
control "Serveur" as S
database "Base de données" as DB

note over E, DB : Pré-condition : l'employé est authentifié.

E -> UI : Ouvrir « Mes demandes »
UI -> S : Charger mes demandes et mon solde
S -> DB : Lire les données
DB --> S : Demandes + solde
S --> UI : Demandes + solde
UI --> E : Afficher la liste avec les statuts

alt Modifier
  E -> UI : Modifier une demande « en attente »
  UI -> S : Envoyer les nouvelles informations
  S -> S : Recalculer les jours\net revérifier les règles
  alt Règle non respectée
    S --> UI : Message d'erreur
    UI --> E : Afficher l'erreur
  else Valide
    S -> DB : Mettre à jour la demande
    S --> UI : Demande modifiée
    UI --> E : Confirmation
  end
else Annuler
  E -> UI : Annuler une demande « en attente »
  UI -> S : Annuler la demande
  S -> DB : Statut → « Annulée »\n+ historique
  S --> UI : Demande annulée
  UI --> E : Confirmation
end

note right of S
  Une demande déjà approuvée
  ou refusée ne peut plus être
  modifiée ni annulée.
end note

@enduml
