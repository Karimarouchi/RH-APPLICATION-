@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam activity {
  BackgroundColor #F7F1FA
  BorderColor #683B77
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #683B77
}
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}

title Diagramme d'activité — Contrôle d'une demande d'autorisation de sortie

start
:Recevoir la demande
(date, heure de début, heure de fin);

if (Date et heures renseignées,\nfin après début ?) then (non)
  #FFEBEE:Refuser : informations invalides;
  stop
endif

if (Durée ≤ durée maximale\n(120 min par défaut) ?) then (non)
  #FFEBEE:Refuser : durée trop longue;
  stop
endif

if (La date est un jour travaillé ?) then (non)
  #FFEBEE:Refuser : jour non travaillé;
  stop
endif

if (Heures comprises dans\nles horaires de travail ?) then (non)
  #FFEBEE:Refuser : hors horaires;
  stop
endif

:Additionner les autorisations du mois
(en attente + approuvées);

if (Total + nouvelle demande\n≤ quota mensuel ?) then (non)
  #FFEBEE:Refuser : quota mensuel dépassé;
  stop
endif

#E8F5E9:Enregistrer la demande « En attente »;
stop

@enduml
