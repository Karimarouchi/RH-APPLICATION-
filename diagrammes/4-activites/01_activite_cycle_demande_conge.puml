@startuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #683B77
skinparam activity {
  BackgroundColor #F7F1FA
  BorderColor #683B77
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #683B77
}
skinparam swimlaneBorderColor #9C7BAA
skinparam note {
  BackgroundColor #FFF8E1
  BorderColor #C9A227
}

title Diagramme d'activité — Cycle de vie d'une demande de congé

|Employé|
start
:Ouvrir « Nouvelle demande »;
floating note right: Pré-condition : l'employé est authentifié.
repeat
  :Choisir le type de congé et les dates;
  |Système|
  :Calculer les jours effectifs
  (week-ends et jours fériés);
  |Employé|
  if (Justificatif obligatoire ?) then (oui)
    :Joindre le justificatif;
  else (non)
  endif
  :Envoyer la demande;
  |Système|
  :Vérifier les règles;
repeat while (Une règle n'est pas respectée ?) is (oui : afficher l'erreur) not (non)
:Enregistrer la demande « En attente »;
:Notifier le chef de département;
|Validateur|
:Examiner la demande;
if (Décision ?) then (approuver)
  |Système|
  :Passer la demande à « Approuvée »;
  if (Congé payé ?) then (oui)
    :Déduire les jours du solde;
  else (non)
  endif
else (refuser)
  |Validateur|
  :Saisir le motif du refus;
  |Système|
  :Passer la demande à « Refusée »;
endif
:Enregistrer l'historique;
:Notifier l'employé;
|Employé|
:Consulter la décision;
stop

@enduml
